{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Static Research Context",
  "type": "object",
  "required": [
    "symbol",
    "name",
    "exchange",
    "as_of",
    "data_as_of",
    "generated_at",
    "horizon",
    "returns",
    "momentum",
    "relative_strength",
    "volatility",
    "volume",
    "liquidity",
    "benchmark_context",
    "market_regime",
    "listing_status",
    "trading_status",
    "data_quality",
    "missing_families",
    "RESEARCH_USABLE",
    "EXECUTION_USABLE",
    "execution_status",
    "PIT_status",
    "source_provenance",
    "snapshot_id",
    "snapshot_hash",
    "evidence_manifest_hash",
    "prediction_decision"
  ],
  "properties": {
    "symbol": {"type": "string", "pattern": "^(sh|sz)[0-9]{6}$"},
    "name": {"type": "string"},
    "exchange": {"type": "string"},
    "as_of": {"type": "string", "format": "date-time"},
    "data_as_of": {"type": "string", "format": "date"},
    "generated_at": {"type": "string", "format": "date-time"},
    "horizon": {"enum": ["D1", "D2", "D5"]},
    "returns": {"type": "object"},
    "momentum": {"type": "object"},
    "relative_strength": {"type": "object"},
    "volatility": {"type": "object"},
    "volume": {"type": "object"},
    "liquidity": {"type": "object"},
    "benchmark_context": {"type": "object"},
    "market_regime": {"type": "object"},
    "listing_status": {"type": "object"},
    "trading_status": {"type": "object"},
    "data_quality": {"type": "object"},
    "missing_families": {"type": "array"},
    "RESEARCH_USABLE": {"const": true},
    "EXECUTION_USABLE": {"const": false},
    "execution_status": {"const": "EXECUTION_DATA_INSUFFICIENT"},
    "PIT_status": {"const": "PIT_APPROXIMATE"},
    "source_provenance": {"type": "object"},
    "snapshot_id": {"type": "string"},
    "snapshot_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence_manifest_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prediction_decision": {"type": "null"}
  },
  "additionalProperties": true
}
