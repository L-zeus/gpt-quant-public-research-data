{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Static Research Refresh Quality Report",
  "type": "object",
  "required": [
    "run_id",
    "trigger",
    "mode",
    "started_at",
    "finished_at",
    "expected_session",
    "previous_data_as_of",
    "new_data_as_of",
    "symbols_attempted",
    "symbols_updated",
    "symbols_unchanged",
    "symbols_failed",
    "provider_failures",
    "fallback_usage",
    "contexts_generated",
    "scanner_evaluated_n",
    "validation_status",
    "security_status",
    "publish_decision",
    "release_id",
    "decision",
    "reason"
  ],
  "properties": {
    "run_id": {"type": "string"},
    "trigger": {"type": "string"},
    "mode": {"enum": ["refresh", "expand"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "expected_session": {"type": ["string", "null"], "format": "date"},
    "previous_data_as_of": {"type": ["string", "null"], "format": "date"},
    "new_data_as_of": {"type": ["string", "null"], "format": "date"},
    "symbols_attempted": {"type": "integer", "minimum": 0},
    "symbols_updated": {"type": "integer", "minimum": 0},
    "symbols_unchanged": {"type": "integer", "minimum": 0},
    "symbols_failed": {"type": "integer", "minimum": 0},
    "provider_failures": {"type": "integer", "minimum": 0},
    "fallback_usage": {"type": "integer", "minimum": 0},
    "contexts_generated": {"type": "integer", "minimum": 0},
    "scanner_evaluated_n": {"type": "integer", "minimum": 0},
    "research_usable_n": {"type": "integer", "minimum": 0},
    "validation_status": {"type": "string"},
    "security_status": {"type": "string"},
    "publish_decision": {"enum": ["YES", "NO"]},
    "release_id": {"type": ["string", "null"]},
    "decision": {"type": "string"},
    "reason": {"type": "string"}
  },
  "additionalProperties": true
}
